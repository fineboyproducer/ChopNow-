# ============================================================================
# ChopNow — Environment Variables
# Copy this file to `.env.local` in each app (apps/web, apps/admin, apps/rider)
# or to a root `.env.local` if using a single shared environment across all
# apps in local development. Never commit real values.
# ============================================================================

# --- Supabase ------------------------------------------------------------
# Found in your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only — never expose to the client. Used for admin operations
# (e.g. Edge Functions, server actions that must bypass RLS deliberately).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App URLs (used for auth redirects, CORS, absolute links) ------------
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
NEXT_PUBLIC_RIDER_APP_URL=http://localhost:3002

# --- Payments (server-only) ------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (order confirmations — see apps/web/lib/email) ------------------
# Leave unset in development: confirmation emails are logged instead of
# sent. Set once a provider (e.g. Resend) is wired into deliverEmail().
EMAIL_PROVIDER_API_KEY=

# --- Maps -----------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxx
# or, if using Google Maps instead of Mapbox:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Messaging (restaurant/rider communication) ---------------------------
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Environment ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
